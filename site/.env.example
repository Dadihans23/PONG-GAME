# Copier ce fichier en .env et le remplir. Ne jamais committer .env.

# --- Secrets (obligatoires) ------------------------------------------------
# Clé de signature des cookies de session (48 caractères aléatoires) :
#   python -m app.hashpw --secret
#   (ou avec Docker : docker compose run --rm --no-deps tilto-site python -m app.hashpw --secret)
SECRET_KEY=

# Hachage scrypt du mot de passe d'administration (jamais le mot de passe en clair) :
#   python -m app.hashpw
#   (ou avec Docker : docker compose run --rm --no-deps tilto-site python -m app.hashpw)
# Changer ce hachage déconnecte toutes les sessions ouvertes.
ADMIN_PASSWORD_HASH=

# --- Adresse publique -----------------------------------------------------------
# Adresse du site, sans « / » final ni chemin : URL canoniques, sitemap.xml,
# robots.txt, Open Graph et données structurées. Jamais l'hôte de la requête.
SITE_URL=https://tilto.fun

# --- Réseau (docker compose) -------------------------------------------------
# Port de la machine hôte sur lequel le site répond (le conteneur écoute sur 8000).
HOST_PORT=8085
# Interface d'écoute : 0.0.0.0 = accessible de l'extérieur sur HOST_PORT ;
# 127.0.0.1 = accessible seulement par le serveur web local (Nginx), à utiliser
# dès que le reverse proxy est en place.
HOST_BIND=0.0.0.0
# Adresses dont uvicorn accepte les en-têtes X-Forwarded-*. Laisser 127.0.0.1
# tant qu'il n'y a pas de proxy (sinon un visiteur pourrait falsifier son IP
# et contourner la limitation des connexions). Derrière Nginx avec HOST_BIND=127.0.0.1,
# mettre l'IP de la passerelle Docker vue par le conteneur (souvent 172.17.0.1 ou
# celle du réseau compose) ou * (le port n'étant alors plus joignable de l'extérieur).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Session ------------------------------------------------------------------
# true dès que le site est servi en HTTPS (cookie envoyé seulement en HTTPS + en-tête HSTS).
COOKIE_SECURE=false
# Durée maximale d'une session d'administration, en secondes (8 h).
SESSION_MAX_AGE=28800
# Limitation des connexions : nombre d'échecs autorisés par IP sur la fenêtre (secondes).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- Fichiers -----------------------------------------------------------------
# Taille maximale d'un APK et d'une image, en Mo.
MAX_APK_MB=200
MAX_IMAGE_MB=5

# Hors Docker seulement : dossier de la base et des fichiers téléversés.
# DATA_DIR=./data

# --- Formulaire de contact ------------------------------------------------------
# Messages acceptés par adresse IP et par heure, tous visiteurs confondus par
# heure, et délai minimal (secondes) entre l'affichage du formulaire et l'envoi.
CONTACT_MAX_PER_HOUR=3
CONTACT_GLOBAL_PER_HOUR=30
CONTACT_MIN_SECONDS=3

# Notification par e-mail à chaque message (facultative). Les messages sont
# toujours enregistrés et lisibles dans Administration › Messages ; si
# SMTP_HOST, SMTP_FROM et CONTACT_NOTIFY_TO sont remplis, un e-mail est aussi
# envoyé (en tâche de fond ; un échec est journalisé sans perdre le message).
# SMTP_PORT : 587 (STARTTLS, par défaut) ou 465 (SSL). SMTP_SECURITY force
# « starttls » ou « ssl » si besoin. SMTP_USER vide = pas d'authentification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SECURITY=starttls
CONTACT_NOTIFY_TO=
